<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/compiler_spec.rxg -->
<!-- Panasonic MN103/AM33 compiler convention, measured on E-M1 III fw 1.6 block 0 (2026-10-10):
     integer args D0,D1 / pointer args A0,A1 (Ghidra needs ptr entries listed first) / more on the stack from (4,sp) of the caller;
     result D0 (pointers sometimes A0); D2,D3,A2,A3 survive calls (the CALL/RET pair saves them).
     Entry SP = caller SP (return address at 0): sleigh moves the callee frame into the callee. -->
<compiler_spec>
  <data_organization>
    <pointer_size value="4" />
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative" />
  <returnaddress>
    <varnode space="stack" offset="0" size="4" />
  </returnaddress>
  <default_proto>
    <prototype name="__panacall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="A0" />
        </pentry>
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="A1" />
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="D0" />
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="D1" />
        </pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="4" space="stack" />
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="A0" />
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="D0" />
        </pentry>
      </output>
      <unaffected>
        <register name="SP" />
        <register name="D2" />
        <register name="D3" />
        <register name="A2" />
        <register name="A3" />
      </unaffected>
      <killedbycall>
        <register name="D0" />
        <register name="D1" />
        <register name="A0" />
        <register name="A1" />
        <register name="MDR" />
      </killedbycall>
    </prototype>
  </default_proto>

  <!-- Old guess kept for comparison (GCC-like: D0,D1 then stack at 12). -->
  <prototype name="__mngcccall" extrapop="0" stackshift="0">
    <input>
      <pentry minsize="1" maxsize="4"><register name="D0" /></pentry>
      <pentry minsize="1" maxsize="4"><register name="D1" /></pentry>
      <pentry minsize="1" maxsize="512" align="4"><addr offset="12" space="stack" /></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="4"><register name="D0" /></pentry>
    </output>
    <unaffected>
      <register name="SP" />
      <register name="D2" /><register name="D3" /><register name="A2" /><register name="A3" />
    </unaffected>
  </prototype>
</compiler_spec>
