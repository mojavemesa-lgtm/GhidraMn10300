@include "mn103.sinc"


define register offset=0x50 size=4 [ EPSW ];
# AM33
define register offset=0x100 size=4 [ USP SSP MSP ];
define register offset=0x110 size=4 [ XR0 XR1 XR2 XR3 ];
define register offset=0x130 size=4 [ RI ];
define register offset=0x150 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 ];

define register offset=0x200 size=4 [ 
	fs0 fs1 fs2 fs3 
	fs4 fs5 fs6 fs7
	fs8 fs9 fs10 fs11
	fs12 fs13 fs14 fs15
	
	fs16 fs17 fs18 fs19
	fs20 fs21 fs22 fs23
	fs24 fs25 fs26 fs27
	fs28 fs29 fs30 fs31
];

attach variables [ Rn0 Rn1 Rn2  Rm0 Rm1 Rm2  Rd0 Rd1 Rd2 ] [ R0 R1 R2 R3 R4 R5 R6 R7 A0 A1 A2 A3 D0 D1 D2 D3];
attach variables [ XRn0 XRn2  XRm0 XRm2 ] [ SP MDRQ MCRH MCRL MCVF _ _ _ _ _ _ _ _ _ _ _ ]; # sim translate_xreg: 0=SP 1=MDRQ 2=MCRH 3=MCRL 4=MCVF


attach variables [ FLn0 FLn2  FLm0 FLm2  FLd0 FLd2 ] [ fs0  fs1  fs2  fs3  fs4  fs5  fs6  fs7  fs8  fs9  fs10 fs11 fs12 fs13 fs14 fs15 ];
attach variables [ FUn0 FUn2  FUm0 FUm2  FUd0 FUd2 ] [ fs16 fs17 fs18 fs19 fs20 fs21 fs22 fs23 fs24 fs25 fs26 fs27 fs28 fs29 fs30 fs31 ];

:MOV "USP", An0		is entryfix=0 & op8=0xf0; op4=0x2 & op2m=0 & An0 	{ An0 = USP; }
:MOV "SSP", An0		is entryfix=0 & op8=0xf0; op4=0x2 & op2m=1 & An0 	{ An0 = SSP; }
:MOV "MSP", An0		is entryfix=0 & op8=0xf0; op4=0x2 & op2m=2 & An0 	{ An0 = MSP; }
:MOV "PC", An0		is entryfix=0 & op8=0xf0; op4=0x2 & op2m=3 & An0 	{ An0 = inst_start; }
:MOV An1, "USP"		is entryfix=0 & op8=0xf0; op4=0x3 & An1 & op2n=0 	{ USP = An1; }
:MOV An1, "SSP"		is entryfix=0 & op8=0xf0; op4=0x3 & An1 & op2n=1		{ SSP = An1; }
:MOV An1, "MSP"		is entryfix=0 & op8=0xf0; op4=0x3 & An1 & op2n=2		{ MSP = An1; }

:MOV "EPSW", Dn0	is entryfix=0 & op8=0xf2; op4=0xe & op2m=3 & Dn0 	{ local t:2 = 0; psw_get(t); Dn0 = (EPSW & 0xffff0000) | zext(t); }
:MOV Dm1, "EPSW"	is entryfix=0 & op8=0xf2; op4=0xf & Dm1 & op2n=1 	{ EPSW = Dm1; local t:2 = Dm1:2; psw_put(t); }


:MOV Am2, Rn0		is entryfix=0 & op8=0xf5; op2i=0 & Am2 & Rn0 		{ Rn0 = Am2; }
:MOV Dm2, Rn0		is entryfix=0 & op8=0xf5; op2i=1 & Dm2 & Rn0 		{ Rn0 = Dm2; }
:MOV Rm1, An0		is entryfix=0 & op8=0xf5; op2i=2 & Rm1 & An0 		{ An0 = Rm1; }
:MOV Rm1, Dn0		is entryfix=0 & op8=0xf5; op2i=3 & Rm1 & Dn0 		{ Dn0 = Rm1; }


:MOV Rm2, Rn0		is entryfix=0 & op8=0xf9; op8=0x08; Rm2 & Rn0 		{ Rn0 = Rm2; }
:MOV XRm2, Rn0		is entryfix=0 & op8=0xf9; op8=0xe8; XRm2 & Rn0 		{ Rn0 = XRm2; }
:MOV Rm2, XRn0		is entryfix=0 & op8=0xf9; op8=0xf8; Rm2 & XRn0 		{ XRn0 = Rm2; }


:MOV (Rm0), Rn2		is entryfix=0 & op8=0xf9; op8=0x0a; Rm0 & Rn2 		{ Rn2 = *:4 Rm0; }
:MOV ("SP"), Rn2	is entryfix=0 & op8=0xf9; op8=0x8a; Rn2 & op2nm=0 	{ Rn2 = *:4 SP; }
:MOV (Rm0+), Rn2	is entryfix=0 & op8=0xf9; op8=0x6a; Rm0 & Rn2 		{ Rn2 = *:4 Rm0; Rm0 = Rm0 + 4; }

:MOV (IMM8), Rn2	is entryfix=0 & op8=0xfb; op8=0x0e; Rn2 & op4l=0; IMM8 		{ local addr:4 = zext(IMM8); Rn2 = *addr; }
:MOV (IMM24), Rn2	is entryfix=0 & op8=0xfd; op8=0x0e; Rn2 & op4l=0; IMM24 		{ local addr:4 = zext(IMM24); Rn2 = *addr; }

:MOV Rm2, (Rn0)			is entryfix=0 & op8=0xf9; op8=0x1a; Rm2 & Rn0 		{ *Rn0 = Rm2; }
:MOV Rm2, ("SP")		is entryfix=0 & op8=0xf9; op8=0x9a; Rm2 & op4l=0  	{ *SP = Rm2; }
:MOV Rm2, (Rn0+)		is entryfix=0 & op8=0xf9; op8=0x7a; Rm2 & Rn0 		{ *Rn0 = Rm2; Rn0 = Rn0 + 4; }
:MOV Rm2, (D8)			is entryfix=0 & op8=0xfb; op8=0x1e; Rm2 & op4l=0; D8 		{ local addr:4 = zext(D8);  *addr = Rm2; }
:MOV Rm2, (IMM24)		is entryfix=0 & op8=0xfd; op8=0x1e; Rm2 & op4l=0; IMM24 		{ local addr:4 = zext(IMM24); *addr = Rm2; }
:MOV (SIMM8, Rm0), Rn2	is entryfix=0 & op8=0xfb; op8=0x0a; Rn2 & Rm0; SIMM8 		{ local addr:4 = sext(SIMM8) + Rm0; Rn2 = *addr; }
:MOV (SIMM24, Rm0), Rn2	is entryfix=0 & op8=0xfd; op8=0x0a; Rn2 & Rm0; SIMM24 		{ local addr:4 = sext(SIMM24) + Rm0; Rn2 = *addr; }

:MOV (Rn2, Rm0), Rd2	is entryfix=0 & op8=0xfb; op8=0x8e; Rn2 & Rm0; Rd2 & op4l=0  { local a:4 = Rn2 + Rm0; Rd2 = *a; }

:MOV Rm2, (SIMM8, Rn0)		is entryfix=0 & op8=0xfb; op8=0x1a; Rm2 & Rn0; SIMM8 		{  local addr:4 = Rn0 + sext(SIMM8); *addr = Rm2; }
:MOV Rm2, (SIMM24, Rn0)		is entryfix=0 & op8=0xfd; op8=0x1a; Rm2 & Rn0; SIMM24 		{  local addr:4 = Rn0 + sext(SIMM24); *addr = Rm2; }
:MOV (IMM8, "SP"), Rn2	is entryfix=0 & op8=0xfb; op8=0x8a; Rn2 & op4l=0; IMM8  { local addr:4 = SP + zext(IMM8); Rn2 = *addr; }
:MOV (IMM24, "SP"), Rn2	is entryfix=0 & op8=0xfd; op8=0x8a; Rn2 & op4l=0; IMM24  { local addr:4 = SP + zext(IMM24); Rn2 = *addr; }
:MOV Rm2, (IMM8, "SP")	is entryfix=0 & op8=0xfb; op8=0x9a; Rm2 & op4l=0; IMM8  { local addr:4 = SP + zext(IMM8); *addr = Rm2; }
:MOV Rm2, (IMM24, "SP")	is entryfix=0 & op8=0xfd; op8=0x9a; Rm2 & op4l=0; IMM24  { local addr:4 = SP + zext(IMM24); *addr = Rm2; }
:MOV Rd2, (Rm2, Rn0)	is entryfix=0 & op8=0xfb; op8=0x9e; Rm2 & Rn0; Rd2 & op4l=0  { local a:4 = Rm2 + Rn0; *a = Rd2; }

:MOV (Rm0+, SIMM8), Rn2	is entryfix=0 & op8=0xfb; op8=0x6a; Rn2 & Rm0; SIMM8  { Rn2 = *Rm0; Rm0 = Rm0 + sext(SIMM8); }
:MOV Rm2, (Rn0+, SIMM8)	is entryfix=0 & op8=0xfb; op8=0x7a; Rm2 & Rn0; SIMM8  { *Rn0 = Rm2; Rn0 = Rn0 + sext(SIMM8); }
:MOV (Rm0+, SIMM24), Rn2	is entryfix=0 & op8=0xfd; op8=0x6a; Rn2 & Rm0; SIMM24  { Rn2 = *Rm0; Rm0 = Rm0 + sext(SIMM24); }
:MOV Rm2, (Rn0+, SIMM24)	is entryfix=0 & op8=0xfd; op8=0x7a; Rm2 & Rn0; SIMM24  { *Rn0 = Rm2; Rn0 = Rn0 + sext(SIMM24); }
:MOV (Rm0+, IMM32), Rn2	is entryfix=0 & op8=0xfe; op8=0x6a; Rn2 & Rm0; IMM32  { Rn2 = *Rm0; Rm0 = Rm0 + IMM32; }
:MOV Rm2, (Rn0+, IMM32)	is entryfix=0 & op8=0xfe; op8=0x7a; Rm2 & Rn0; IMM32  { *Rn0 = Rm2; Rn0 = Rn0 + IMM32; }

#:MOV (D8, Am0), "SP"	is op8=0xf8; op4=0xf & op2m=0 & Am0; D8 		{  mn_todo(); }
#:MOV "SP", (D8, An0)	is op8=0xfe; op4=0xf & op2m=1 & An0; D8 		{  mn_todo(); }

:MOV SIMM8, Rn0 		is entryfix=0 & op8=0xfb; op8=0x08; Rn2 & Rn0 & op4=op4l; SIMM8  	{ Rn0 = sext(SIMM8); } # is this signed?
:MOV SIMM24, Rn0 		is entryfix=0 & op8=0xfd; op8=0x08; Rn2 & Rn0 & op4=op4l; SIMM24  	{ Rn0 = sext(SIMM24); } # is this signed?
:MOV SIMM32, Rn0 		is entryfix=0 & op8=0xfe; op8=0x08; Rn2 & Rn0 & op4=op4l; SIMM32  	{ Rn0 = SIMM32; } # is this signed?
:MOV SIMM8, XRn0 		is entryfix=0 & op8=0xfb; op8=0xf8; XRn2 & XRn0 & op4=op4l; SIMM8  	{ XRn0 = sext(SIMM8); } # is this signed?
:MOV SIMM24, XRn0 		is entryfix=0 & op8=0xfd; op8=0xf8; XRn2 & XRn0 & op4=op4l; SIMM24  	{ XRn0 = sext(SIMM24); } # is this signed?
:MOV SIMM32, XRn0 		is entryfix=0 & op8=0xfe; op8=0xf8; XRn2 & XRn0 & op4=op4l; SIMM32  	{ XRn0 = SIMM32; } # is this signed?

:MOV (IMM32), Rn2 		is entryfix=0 & op8=0xfe; op8=0x0e; Rn2 & op4l=0; IMM32  	{ Rn2 = *IMM32; } # TODO: add imm32 mem. abs32
:MOV Rm2, (IMM32) 		is entryfix=0 & op8=0xfe; op8=0x1e; Rm2 & op4l=0; IMM32  	{ *IMM32 = Rm2; } # TODO: add imm32 mem. abs32
:MOV (IMM32, Rm0), Rn2 	is entryfix=0 & op8=0xfe; op8=0x0a; Rn2 & Rm0; IMM32  		{ local addr:4 = Rm0 + IMM32; Rn2 = *addr; } 
:MOV Rm2, (IMM32, Rn0)	is entryfix=0 & op8=0xfe; op8=0x1a; Rm2 & Rn0; IMM32  { local addr:4 = Rn0 + IMM32; *addr = Rm2; }
:MOV (IMM32, "SP"), Rn2 is  entryfix=0 & op8=0xfe; op8=0x8a; Rn2 & op4l=0; IMM32  	{ local addr:4 = SP + IMM32; Rn2 = *addr; }
:MOV Rm2, (IMM32, "SP") is  entryfix=0 & op8=0xfe; op8=0x9a; Rm2 & op4l=0; IMM32  	{ local addr:4 = SP + IMM32; *addr = Rm2; }


:MOVU IMM8, Rn0 		is entryfix=0 & op8=0xfb; op8=0x18; Rn2 & Rn0 & op4=op4l; IMM8  		{ Rn0 = zext(IMM8); }
:MOVU IMM24, Rn0 		is entryfix=0 & op8=0xfd; op8=0x18; Rn2 & Rn0 & op4=op4l; IMM24  	{ Rn0 = zext(IMM24); }
:MOVU IMM32, Rn0 		is entryfix=0 & op8=0xfe; op8=0x18; Rn2 & Rn0 & op4=op4l; IMM32  	{ Rn0 = IMM32; }


# TODO: more mac and swap and movbu shit


:MOVBU (Rm0), Rn2 			is entryfix=0 & op8=0xf9; op8=0x2a; Rm0 & Rn2  			{ Rn2 = zext(*:1 Rm0); }
:MOVBU Rm2, (Rn0) 			is entryfix=0 & op8=0xf9; op8=0x3a; Rm2 & Rn0  			{ *:1 Rn0 = Rm2:1; }
:MOVBU ("SP"), Rn2 			is entryfix=0 & op8=0xf9; op8=0xaa; Rn2 & op4l=0  		{ Rn2 = zext(*:1 SP); }
:MOVBU Rm2, ("SP") 			is entryfix=0 & op8=0xf9; op8=0xba; Rm2 & op4l=0  		{ *:1 SP = Rm2:1; }
:MOVBU (D8, Rm0), Rn2 		is entryfix=0 & op8=0xfb; op8=0x2a; Rm0 & Rn2; D8  		{ Rn2 = zext(*:1 (Rm0 + sext(D8))); }
:MOVBU (D24, Rm0), Rn2 		is entryfix=0 & op8=0xfd; op8=0x2a; Rm0 & Rn2; D24  		{ Rn2 = zext(*:1 (Rm0 + sext(D24))); }
:MOVBU Rm2, (D8, Rn0) 		is entryfix=0 & op8=0xfb; op8=0x3a; Rm2 & Rn0; D8  		{ *:1 (Rn0 + sext(D8)) = Rm2:1; }
:MOVBU Rm2, (D24, Rn0) 		is entryfix=0 & op8=0xfd; op8=0x3a; Rm2 & Rn0; D24  		{ *:1 (Rn0 + sext(D24)) = Rm2:1; }
:MOVBU (IMM8, "SP"), Rn2	is entryfix=0 & op8=0xfb; op8=0xaa; Rn2 & op4l=0; IMM8  { Rn2 = zext(*:1 (SP + zext(IMM8))); }
:MOVBU (IMM24, "SP"), Rn2	is entryfix=0 & op8=0xfd; op8=0xaa; Rn2 & op4l=0; IMM24  { Rn2 = zext(*:1 (SP + zext(IMM24))); }
:MOVBU Rm2, (IMM8, "SP")	is entryfix=0 & op8=0xfb; op8=0xba; Rm2 & op4l=0; IMM8  { *:1 (SP + zext(IMM8)) = Rm2:1; }
:MOVBU Rm2, (IMM24, "SP")	is entryfix=0 & op8=0xfd; op8=0xba; Rm2 & op4l=0; IMM24  { *:1 (SP + zext(IMM24)) = Rm2:1; }
:MOVBU (IMM8), Rn2	is entryfix=0 & op8=0xfb; op8=0x2e; Rn2 & op4l=0; IMM8  { local addr:4 = zext(IMM8); Rn2 = zext(*:1 addr); }
:MOVBU (IMM24), Rn2	is entryfix=0 & op8=0xfd; op8=0x2e; Rn2 & op4l=0; IMM24  { local addr:4 = zext(IMM24); Rn2 = zext(*:1 addr); }
:MOVBU Rm2, (IMM8)	is entryfix=0 & op8=0xfb; op8=0x3e; Rm2 & op4l=0; IMM8  { local addr:4 = zext(IMM8); *:1 addr = Rm2:1; }
:MOVBU Rm2, (IMM24)	is entryfix=0 & op8=0xfd; op8=0x3e; Rm2 & op4l=0; IMM24  { local addr:4 = zext(IMM24); *:1 addr = Rm2:1; }
:MOVBU (Rn2, Rm0), Rd2	is entryfix=0 & op8=0xfb; op8=0xae; Rn2 & Rm0; Rd2 & op4l=0  { local a:4 = Rn2 + Rm0; Rd2 = zext(*:1 a); }
:MOVBU Rd2, (Rm2, Rn0)	is entryfix=0 & op8=0xfb; op8=0xbe; Rm2 & Rn0; Rd2 & op4l=0  { local a:4 = Rm2 + Rn0; *:1 a = Rd2:1; }

:MOVBU (IMM32, Rm0), Rn2	is entryfix=0 & op8=0xfe; op8=0x2a; Rn2 & Rm0; IMM32  { Rn2 = zext(*:1 (Rm0 + IMM32)); }
:MOVBU Rm2, (IMM32, Rn0)	is entryfix=0 & op8=0xfe; op8=0x3a; Rm2 & Rn0; IMM32  { *:1 (Rn0 + IMM32) = Rm2:1; }
:MOVBU (IMM32, "SP"), Rn2	is entryfix=0 & op8=0xfe; op8=0xaa; Rn2 & op4l=0; IMM32  { Rn2 = zext(*:1 (SP + IMM32)); }
:MOVBU Rm2, (IMM32, "SP")	is entryfix=0 & op8=0xfe; op8=0xba; Rm2 & op4l=0; IMM32  { *:1 (SP + IMM32) = Rm2:1; }
:MOVBU (IMM32), Rn2	is entryfix=0 & op8=0xfe; op8=0x2e; Rn2 & op4l=0; IMM32  { Rn2 = zext(*:1 IMM32); }
:MOVBU Rm2, (IMM32)	is entryfix=0 & op8=0xfe; op8=0x3e; Rm2 & op4l=0; IMM32  { *:1 IMM32 = Rm2:1; }

# TODO: movhu
:MOVHU (Rm0), Rn2 			is entryfix=0 & op8=0xf9; op8=0x4a; Rm0 & Rn2  			{ Rn2 = zext(*:2 Rm0); }
:MOVHU Rm2, (Rn0) 			is entryfix=0 & op8=0xf9; op8=0x5a; Rm2 & Rn0  			{ *:2 Rn0 = Rm2:2; }
:MOVHU ("SP"), Rn2 			is entryfix=0 & op8=0xf9; op8=0xca; Rn2 & op4l=0  		{ Rn2 = zext(*:2 SP); }
:MOVHU Rm2, ("SP") 			is entryfix=0 & op8=0xf9; op8=0xda; Rm2 & op4l=0  		{ *:2 SP = Rm2:2; }
:MOVHU Rm2, (Rn0+) 			is entryfix=0 & op8=0xf9; op8=0xfa; Rm2 & Rn0  			{ *:2 Rn0 = Rm2:2; Rn0 = Rn0 + 2; }
:MOVHU (D8, Rm0), Rn2 		is entryfix=0 & op8=0xfb; op8=0x4a; Rm0 & Rn2; D8  		{ Rn2 = zext(*:2 (Rm0 + sext(D8))); }
:MOVHU (D24, Rm0), Rn2 		is entryfix=0 & op8=0xfd; op8=0x4a; Rm0 & Rn2; D24  		{ Rn2 = zext(*:2 (Rm0 + sext(D24))); }
:MOVHU Rm2, (D8, Rn0) 		is entryfix=0 & op8=0xfb; op8=0x5a; Rm2 & Rn0; D8  		{ *:2 (Rn0 + sext(D8)) = Rm2:2; }
:MOVHU Rm2, (D24, Rn0) 		is entryfix=0 & op8=0xfd; op8=0x5a; Rm2 & Rn0; D24  		{ *:2 (Rn0 + sext(D24)) = Rm2:2; }
:MOVHU (IMM8, "SP"), Rn2	is entryfix=0 & op8=0xfb; op8=0xca; Rn2 & op4l=0; IMM8  { Rn2 = zext(*:2 (SP + zext(IMM8))); }
:MOVHU (IMM24, "SP"), Rn2	is entryfix=0 & op8=0xfd; op8=0xca; Rn2 & op4l=0; IMM24  { Rn2 = zext(*:2 (SP + zext(IMM24))); }
:MOVHU Rm2, (IMM8, "SP")	is entryfix=0 & op8=0xfb; op8=0xda; Rm2 & op4l=0; IMM8  { *:2 (SP + zext(IMM8)) = Rm2:2; }
:MOVHU Rm2, (IMM24, "SP")	is entryfix=0 & op8=0xfd; op8=0xda; Rm2 & op4l=0; IMM24  { *:2 (SP + zext(IMM24)) = Rm2:2; }
:MOVHU (IMM8), Rn2	is entryfix=0 & op8=0xfb; op8=0x4e; Rn2 & op4l=0; IMM8  { local addr:4 = zext(IMM8); Rn2 = zext(*:2 addr); }
:MOVHU (IMM24), Rn2	is entryfix=0 & op8=0xfd; op8=0x4e; Rn2 & op4l=0; IMM24  { local addr:4 = zext(IMM24); Rn2 = zext(*:2 addr); }
:MOVHU (Rn2, Rm0), Rd2	is entryfix=0 & op8=0xfb; op8=0xce; Rn2 & Rm0; Rd2 & op4l=0  { local a:4 = Rn2 + Rm0; Rd2 = zext(*:2 a); }
:MOVHU Rd2, (Rm2, Rn0)	is entryfix=0 & op8=0xfb; op8=0xde; Rm2 & Rn0; Rd2 & op4l=0  { local a:4 = Rm2 + Rn0; *:2 a = Rd2:2; }

:MOVHU (IMM32), Rn2 		is entryfix=0 & op8=0xfe; op8=0x4e; Rn2 & op4l=0; IMM32  	{  Rn2 = zext(*:2 IMM32); } # TODO abs32
:MOVHU Rm2, (IMM32) 		is entryfix=0 & op8=0xfe; op8=0x5e; Rm2 & op4l=0; IMM32  	{ *:2 IMM32 = Rm2:2; }


:MOVM ("USP"), PopRegsBrace 	is entryfix=0 & op8=0xf8; op8=0xce; PopRegsBrace 	{ mult_addr = USP; build PopRegsBrace; USP = mult_addr; }
:MOVM RegsBrace, ("USP")		is entryfix=0 & op8=0xf8; op8=0xcf; RegsBrace 		{ mult_addr = USP; build RegsBrace; USP = mult_addr; }


:EXT Rn0 		is entryfix=0 & op8=0xf9; op8=0x18; Rm2 & Rn0 & op4=op4l { MDR = Rn0 s>> 31; }
:EXTB Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x28; Rm2 & Rn0 { Rn0 = sext(Rm2:1); }
:EXTBU Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x38; Rm2 & Rn0 { Rn0 = zext(Rm2:1); }
:EXTH Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x48; Rm2 & Rn0 { Rn0 = sext(Rm2:2); }
:EXTHU Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x58; Rm2 & Rn0 { Rn0 = zext(Rm2:2); }

:CLR Rn0	is entryfix=0 & op8=0xf9; op8=0x68; Rn2 & Rn0 & op4=op4l  { Rn0 = 0; update_logic(Rn0); }

:ADD Rm2, Rn0, Rd2 		is entryfix=0 & op8=0xfb; op8=0x7c; Rm2 & Rn0; Rd2 & op4l=0  		{ local addval:4 = Rm2; update_add(addval, Rn0); Rd2 = addval; }
:ADD Rm2, Rn0 			is entryfix=0 & op8=0xf9; op8=0x78; Rm2 & Rn0  						{ update_add(Rn0, Rm2); }
:ADD SIMM8, Rn0 		is entryfix=0 & op8=0xfb; op8=0x78; Rn2 & Rn0 & op4=op4l; SIMM8  	{ update_add(Rn0, sext(SIMM8)); }
:ADD SIMM24, Rn0 		is entryfix=0 & op8=0xfd; op8=0x78; Rn2 & Rn0 & op4=op4l; SIMM24  	{ update_add(Rn0, sext(SIMM24)); }
:ADD SIMM32, Rn0 		is entryfix=0 & op8=0xfe; op8=0x78; Rn2 & Rn0 & op4=op4l; SIMM32  	{ update_add(Rn0, SIMM32); }
:ADDC Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x8c; Rm2 & Rn0; Rd2 & op4l=0  { local v:4 = Rn0; update_addc(v, Rm2); Rd2 = v; }
:ADDC Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x88; Rm2 & Rn0  { update_addc(Rn0, Rm2); }
:ADDC SIMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x88; Rn2 & Rn0 & op4=op4l; SIMM8  { update_addc(Rn0, sext(SIMM8)); }
:ADDC SIMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0x88; Rn2 & Rn0 & op4=op4l; SIMM24  { update_addc(Rn0, sext(SIMM24)); }
:ADDC SIMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0x88; Rn2 & Rn0 & op4=op4l; SIMM32  { update_addc(Rn0, SIMM32); }


:SUB Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x9c; Rm2 & Rn0; Rd2 & op4l=0  { local v:4 = Rn0; update_sub_am33(v, Rm2); Rd2 = v; }
:SUB Rm2, Rn0 			is entryfix=0 & op8=0xf9; op8=0x98; Rm2 & Rn0  						{ update_sub(Rn0, Rm2); }
:SUB SIMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x98; Rn2 & Rn0 & op4=op4l; SIMM8  { update_sub(Rn0, sext(SIMM8)); }
:SUB SIMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0x98; Rn2 & Rn0 & op4=op4l; SIMM24  { update_sub(Rn0, sext(SIMM24)); }
:SUB SIMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0x98; Rn2 & Rn0 & op4=op4l; SIMM32  { update_sub(Rn0, SIMM32); }
:SUBC Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0xac; Rm2 & Rn0; Rd2 & op4l=0  { local v:4 = Rn0; update_subc_am33(v, Rm2); Rd2 = v; }
:SUBC Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0xa8; Rm2 & Rn0  { update_subc_am33(Rn0, Rm2); }
:SUBC SIMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0xa8; Rn2 & Rn0 & op4=op4l; SIMM8  { update_subc_am33(Rn0, sext(SIMM8)); }
:SUBC SIMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0xa8; Rn2 & Rn0 & op4=op4l; SIMM24  { update_subc_am33(Rn0, sext(SIMM24)); }
:SUBC SIMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0xa8; Rn2 & Rn0 & op4=op4l; SIMM32  { update_subc_am33(Rn0, SIMM32); }


:MUL Rm2, Rn0, Rd2, Rd0 is  entryfix=0 & op8=0xfb; op8=0xad; Rm2 & Rn0; Rd2 & Rd0
{
	# sim: first-listed destination (high nibble) gets the HIGH word, the second the LOW word; only Z (64-bit result==0) and N (high word) change, C and V untouched.
	local r:8 = sext(Rm2) * sext(Rn0);
	local hi:4 = r(4);
	local lo:4 = r:4;
	Rd2 = hi;
	Rd0 = lo;
	$(ZF) = (hi == 0) && (lo == 0);
	$(NF) = hi s< 0;
}
:MUL Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0xa9; Rm2 & Rn0  { local r:8=sext(Rn0)*sext(Rm2); Rn0=r:4; MDR=r(4); update_logic(Rn0); }
:MUL SIMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0xa9; Rn2 & Rn0 & op4=op4l; SIMM8  { local r:8=sext(Rn0)*sext(SIMM8); Rn0=r:4; MDR=r(4); update_logic(Rn0); }
:MUL SIMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0xa9; Rn2 & Rn0 & op4=op4l; SIMM24  { local r:8=sext(Rn0)*sext(SIMM24); Rn0=r:4; MDR=r(4); update_logic(Rn0); }
:MUL SIMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0xa9; Rn2 & Rn0 & op4=op4l; SIMM32  { local r:8=sext(Rn0)*sext(SIMM32); Rn0=r:4; MDR=r(4); update_logic(Rn0); }

:MULU Rm2, Rn0, Rd2, Rd0 is  entryfix=0 & op8=0xfb; op8=0xbd; Rm2 & Rn0; Rd2 & Rd0
{
	# sim: first-listed destination (high nibble) gets the HIGH word, the second the LOW word; only Z (64-bit result==0) and N (high word) change, C and V untouched.
	local r:8 = zext(Rm2) * zext(Rn0);
	local hi:4 = r(4);
	local lo:4 = r:4;
	Rd2 = hi;
	Rd0 = lo;
	$(ZF) = (hi == 0) && (lo == 0);
	$(NF) = hi s< 0;
}

:MULU Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0xb9; Rm2 & Rn0  { local r:8=zext(Rn0)*zext(Rm2); Rn0=r:4; MDR=r(4); update_logic(Rn0); }
:MULU IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0xb9; Rn2 & Rn0 & op4=op4l; IMM8  { local r:8=zext(Rn0)*zext(IMM8); Rn0=r:4; MDR=r(4); update_logic(Rn0); }
:MULU IMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0xb9; Rn2 & Rn0 & op4=op4l; IMM24  { local im:4 = sext(IMM24); local r:8=zext(Rn0)*zext(im); Rn0=r:4; MDR=r(4); update_logic(Rn0); }  # sim: MULU imm24 sign-extends the immediate (EXTEND24); copied
:MULU IMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0xb9; Rn2 & Rn0 & op4=op4l; IMM32  { local r:8=zext(Rn0)*zext(IMM32); Rn0=r:4; MDR=r(4); update_logic(Rn0); }


:DIV Rm2, Rn0 			is entryfix=0 & op8=0xf9; op8=0xc9; Rm2 & Rn0
{
	# GNU sim: 64-bit dividend MDR:Rn; quotient -> Rn, remainder -> MDR, C and V cleared. Divide by zero (the sim itself crashes): treated like the base ISA, V=1, Rn=0xff, MDR=low word of dividend.
	local r:8 = (zext(MDR) << 32) | zext(Rn0);
	local den:8 = sext(Rm2);
	local zero:1 = (Rm2 == 0);
	if (zero) goto <dz>;
	local q:8 = r s/ den;
	local rem:8 = r s% den;
	Rn0 = q:4;
	MDR = rem:4;
	$(VF) = 0;
	goto <done>;
	<dz>
	MDR = r:4;
	Rn0 = 0xff;
	$(VF) = 1;
	<done>
	$(ZF) = (Rn0 == 0);
	$(NF) = Rn0 s< 0;
	$(CF) = 0;
}

:DIVU Rm2, Rn0 			is entryfix=0 & op8=0xf9; op8=0xd9; Rm2 & Rn0
{
	# GNU sim: 64-bit dividend MDR:Rn; quotient -> Rn, remainder -> MDR, C and V cleared. Divide by zero (the sim itself crashes): treated like the base ISA, V=1, Rn=0xff, MDR=low word of dividend.
	local r:8 = (zext(MDR) << 32) | zext(Rn0);
	local den:8 = zext(Rm2);
	local zero:1 = (Rm2 == 0);
	if (zero) goto <dz>;
	local q:8 = r / den;
	local rem:8 = r % den;
	Rn0 = q:4;
	MDR = rem:4;
	$(VF) = 0;
	goto <done>;
	<dz>
	MDR = r:4;
	Rn0 = 0xff;
	$(VF) = 1;
	<done>
	$(ZF) = (Rn0 == 0);
	$(NF) = Rn0 s< 0;
	$(CF) = 0;
}

:INC Rn2 		is entryfix=0 & op8=0xf9; op8=0xb8; Rn2 & Rn0 & op4l=op4 	{ local one:4 = 1; update_add(Rn0, one); }
:INC4 Rn2 		is entryfix=0 & op8=0xf9; op8=0xc8; Rn2 & Rn0 & op4l=op4 	{ local four:4 = 4; update_add(Rn0, four); }


:CMP Rm2, Rn0 		is entryfix=0 & op8=0xf9; op8=0xd8; Rm2 & Rn0  						{ update_sub_flags(Rn0, Rm2); }
:CMP SIMM8, Rn0 	is entryfix=0 & op8=0xfb; op8=0xd8; Rm2 & Rn0 & op4=op4l; SIMM8  	{ update_sub_flags(Rn0, sext(SIMM8)); }
:CMP SIMM24, Rn0 	is entryfix=0 & op8=0xfd; op8=0xd8; Rm2 & Rn0 & op4=op4l; SIMM24  	{ update_sub_flags(Rn0, sext(SIMM24)); }
:CMP SIMM32, Rn0 	is entryfix=0 & op8=0xfe; op8=0xd8; Rm2 & Rn0 & op4=op4l; SIMM32  	{ update_sub_flags(Rn0, SIMM32); }

:AND Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x0d; Rm2 & Rn0; Rd2 & op4l=0  { Rd2 = Rm2 & Rn0; update_logic(Rd2); }
:AND IMM32, "EPSW" 		is entryfix=0 & op8=0xfc; op8=0xfc; IMM32			  				{ local t:2 = 0; psw_get(t); local e:4 = ((EPSW & 0xffff0000) | zext(t)) & IMM32; EPSW = e; local u:2 = e:2; psw_put(u); }
:AND Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x09; Rm2 & Rn0  { Rn0 = Rn0 & Rm2; update_logic(Rn0); }
:AND IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x09; Rn2 & Rn0 & op4=op4l; IMM8  { Rn0 = Rn0 & zext(IMM8); update_logic(Rn0); }
:AND IMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0x09; Rn2 & Rn0 & op4=op4l; IMM24  { Rn0 = Rn0 & zext(IMM24); update_logic(Rn0); }
:AND IMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0x09; Rn2 & Rn0 & op4=op4l; IMM32  { Rn0 = Rn0 & IMM32; update_logic(Rn0); }

:OR Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x1d; Rm2 & Rn0; Rd2 & op4l=0  { Rd2 = Rm2 | Rn0; update_logic(Rd2); }
:OR IMM32, "EPSW" 		is entryfix=0 & op8=0xfc; op8=0xfd; IMM32			  				{ local t:2 = 0; psw_get(t); local e:4 = ((EPSW & 0xffff0000) | zext(t)) | IMM32; EPSW = e; local u:2 = e:2; psw_put(u); }
:OR Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x19; Rm2 & Rn0  { Rn0 = Rn0 | Rm2; update_logic(Rn0); }
:OR IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x19; Rn2 & Rn0 & op4=op4l; IMM8  { Rn0 = Rn0 | zext(IMM8); update_logic(Rn0); }
:OR IMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0x19; Rn2 & Rn0 & op4=op4l; IMM24  { Rn0 = Rn0 | zext(IMM24); update_logic(Rn0); }
:OR IMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0x19; Rn2 & Rn0 & op4=op4l; IMM32  { Rn0 = Rn0 | IMM32; update_logic(Rn0); }

:XOR Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x2d; Rm2 & Rn0; Rd2 & op4l=0  { Rd2 = Rm2 ^ Rn0; update_logic(Rd2); }
:XOR Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x29; Rm2 & Rn0  { Rn0 = Rn0 ^ Rm2; update_logic(Rn0); }
:XOR IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x29; Rn2 & Rn0 & op4=op4l; IMM8  { Rn0 = Rn0 ^ zext(IMM8); update_logic(Rn0); }
:XOR IMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0x29; Rn2 & Rn0 & op4=op4l; IMM24  { Rn0 = Rn0 ^ zext(IMM24); update_logic(Rn0); }
:XOR IMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0x29; Rn2 & Rn0 & op4=op4l; IMM32  { Rn0 = Rn0 ^ IMM32; update_logic(Rn0); }


:NOT Rn0	is entryfix=0 & op8=0xf9; op8=0x39; Rn2 & Rn0 & op4=op4l  { Rn0 = ~Rn0; update_logic(Rn0); }

:BTST IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0xe9; Rn2 & Rn0 & op4=op4l; IMM8  { local t:4 = Rn0 & zext(IMM8); update_logic(t); }
:BTST IMM24, Rn0	is entryfix=0 & op8=0xfd; op8=0xe9; Rn2 & Rn0 & op4=op4l; IMM24  { local t:4 = Rn0 & zext(IMM24); update_logic(t); }
:BTST IMM32, Rn0	is entryfix=0 & op8=0xfe; op8=0xe9; Rn2 & Rn0 & op4=op4l; IMM32  { local t:4 = Rn0 & IMM32; update_logic(t); }


:ASR Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x4d; Rm2 & Rn0; Rd2 & op4l=0  { local o:4 = Rn0; local v:4 = o s>> (Rm2 & 0x1f); $(CF) = (o & 1) != 0; Rd2 = v; shift_zn(v); }
:ASR Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x49; Rm2 & Rn0  { local o:4 = Rn0; local v:4 = o s>> (Rm2 & 0x1f); $(CF) = (o & 1) != 0; Rn0 = v; shift_zn(v); }
:ASR IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x49; Rn2 & Rn0 & op4=op4l; IMM8  { local o:4 = Rn0; local v:4 = o s>> (IMM8 & 0x1f); $(CF) = (o & 1) != 0; Rn0 = v; shift_zn(v); }
:ASR IMM24, Rn0 		is entryfix=0 & op8=0xfd; op8=0x49; Rn2 & Rn0 & op4=op4l; IMM24  	{ mn_todo(); } # who wants to shift a 32 bit valule by imm24?? is this the result of the "UDF" opcode? 
:ASR IMM32, Rn0 		is entryfix=0 & op8=0xfe; op8=0x49; Rn2 & Rn0 & op4=op4l; IMM32  	{ mn_todo(); }

:LSR Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x5d; Rm2 & Rn0; Rd2 & op4l=0  { local o:4 = Rn0; local v:4 = o >> (Rm2 & 0x1f); $(CF) = (o & 1) != 0; Rd2 = v; shift_zn(v); }
:LSR Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x59; Rm2 & Rn0  { local o:4 = Rn0; local v:4 = o >> (Rm2 & 0x1f); $(CF) = (o & 1) != 0; Rn0 = v; shift_zn(v); }
:LSR IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x59; Rn2 & Rn0 & op4=op4l; IMM8  { local o:4 = Rn0; local v:4 = o >> (IMM8 & 0x1f); $(CF) = (o & 1) != 0; Rn0 = v; shift_zn(v); }
:LSR IMM24, Rn0 		is entryfix=0 & op8=0xfd; op8=0x59; Rn2 & Rn0 & op4=op4l; IMM24  	{ $(CF) = Rn0:1 & 1; Rn0 = Rn0 >> zext(IMM24); 	update_ZN_S32(Rn0); } # TODO: flags
:LSR IMM32, Rn0 		is entryfix=0 & op8=0xfe; op8=0x59; Rn2 & Rn0 & op4=op4l; IMM32  	{ $(CF) = Rn0:1 & 1; Rn0 = Rn0 >> IMM32; 		update_ZN_S32(Rn0); } # TODO: flags

:ASL Rm2, Rn0, Rd2	is entryfix=0 & op8=0xfb; op8=0x6d; Rm2 & Rn0; Rd2 & op4l=0  { local v:4 = Rn0 << (Rm2 & 0x1f); Rd2 = v; shift_zn(v); $(CF) = 0; }
:ASL Rm2, Rn0	is entryfix=0 & op8=0xf9; op8=0x69; Rm2 & Rn0  { local v:4 = Rn0 << (Rm2 & 0x1f); Rn0 = v; shift_zn(v); }
:ASL IMM8, Rn0	is entryfix=0 & op8=0xfb; op8=0x69; Rn2 & Rn0 & op4=op4l; IMM8  { local v:4 = Rn0 << (IMM8 & 0x1f); Rn0 = v; shift_zn(v); }
:ASL IMM24, Rn0 		is entryfix=0 & op8=0xfd; op8=0x69; Rn2 & Rn0 & op4=op4l; IMM24  	{ mn_todo(); }
:ASL IMM32, Rn0 		is entryfix=0 & op8=0xfe; op8=0x69; Rn2 & Rn0 & op4=op4l; IMM32  	{ mn_todo(); }

:ASL2 Rn0	is entryfix=0 & op8=0xf9; op8=0x79; Rn2 & Rn0 & op4=op4l  { local v:4 = Rn0 << 2; Rn0 = v; shift_zn(v); }

:ROR Rn0	is entryfix=0 & op8=0xf9; op8=0x89; Rn2 & Rn0 & op4=op4l  { local c:1 = Rn0:1 & 1; local v:4 = (Rn0 >> 1) | (zext($(CF)) << 31); Rn0 = v; update_logic(v); $(CF) = c; }
:ROL Rn0	is entryfix=0 & op8=0xf9; op8=0x99; Rn2 & Rn0 & op4=op4l  { local c:1 = (Rn0 s< 0); local v:4 = (Rn0 << 1) | zext($(CF)); Rn0 = v; update_logic(v); $(CF) = c; }


# FPU SHIT. find it in "sim/mn10300/am33-2
:FMOV (Rm2), FLn0 			is entryfix=0 & op8=0xf9; op8=0x20; Rm2 & FLn0  	{ FLn0 = *Rm2; }
:FMOV (Rm2), FUn0 			is entryfix=0 & op8=0xf9; op8=0x21; Rm2 & FUn0  	{ FUn0 = *Rm2; }
:FMOV (Rm2+), FLn0 			is entryfix=0 & op8=0xf9; op8=0x22; Rm2 & FLn0  	{ FLn0 = *Rm2; Rm2=Rm2+4; }
:FMOV (Rm2+), FUn0 			is entryfix=0 & op8=0xf9; op8=0x23; Rm2 & FUn0  	{ FUn0 = *Rm2; Rm2=Rm2+4; }
:FMOV ("SP"), FLn0 			is entryfix=0 & op8=0xf9; op8=0x24; FLn0  		{ FLn0 = *SP; }
:FMOV ("SP"), FUn0 			is entryfix=0 & op8=0xf9; op8=0x25; FUn0  		{ FUn0 = *SP; }
:FMOV Rm2, FLn0 			is entryfix=0 & op8=0xf9; op8=0x26; Rm2 & FLn0  	{ FLn0 = Rm2; }
:FMOV Rm2, FUn0 			is entryfix=0 & op8=0xf9; op8=0x27; Rm2 & FUn0  	{ FUn0 = Rm2; }

:FMOV (D8, "SP"), FLn0 		is entryfix=0 & op8=0xfb; op8=0x24; FLn0; D8  	{ local addr:4 = SP + zext(D8); FLn0 = *addr; }
:FMOV (D8, "SP"), FUn0 		is entryfix=0 & op8=0xfb; op8=0x25; FUn0; D8  	{ local addr:4 = SP + zext(D8); FUn0 = *addr; }

:FMOV FUm2, (IMM8, "SP") 	is entryfix=0 & op8=0xfb; op8=0x36; FUm2 & op4l=0; IMM8  	{ local addr:4 = SP + zext(IMM8); *addr = FUm2; }

:FMOV IMM32, FLn0 		is entryfix=0 & op8=0xfe; op8=0x26; op4=0 & FLn0; IMM32  	{ FLn0 = IMM32; }
:FMOV IMM32, FUn0 		is entryfix=0 & op8=0xfe; op8=0x27; op4=0 & FUn0; IMM32  	{ FUn0 = IMM32; }

:FMUL IMM32, FLm2, FLn0 	is entryfix=0 & op8=0xfe; op4=7; FLm2 & FLn0; IMM32 { mn_todo(); } # TODO: the XY bit indicate upper or lower for float register bank. not sure how to do that

# Is this defined in original?
define pcodeop syscall;
:SYSCALL is  entryfix=0 & op8=0xf0; op4=0xe & op4l 		{  local id:1 = op4l & 0xf; syscall(id); }


# Root: optional callee-frame allocation at function entry (see contextreg note in mn103.sinc)
:^instruction is entryfix=1 & fimm & instruction [ entryfix=0; ] { SP = SP - fimm; build instruction; }


# --- group 4 additions: MOVHU forms that were missing (GNU sim am33.igen) ---
:MOVHU (Rm0+), Rn2 	is entryfix=0 & op8=0xf9; op8=0xea; Rn2 & Rm0 { Rn2 = zext(*:2 Rm0); Rm0 = Rm0 + 2; }
:MOVHU (Rm0+, SIMM8), Rn2 	is entryfix=0 & op8=0xfb; op8=0xea; Rn2 & Rm0; SIMM8 { Rn2 = zext(*:2 Rm0); Rm0 = Rm0 + sext(SIMM8); }
:MOVHU Rm2, (Rn0+, SIMM8) 	is entryfix=0 & op8=0xfb; op8=0xfa; Rm2 & Rn0; SIMM8 { *:2 Rn0 = Rm2:2; Rn0 = Rn0 + sext(SIMM8); }
:MOVHU (Rm0+, SIMM24), Rn2 	is entryfix=0 & op8=0xfd; op8=0xea; Rn2 & Rm0; SIMM24 { Rn2 = zext(*:2 Rm0); Rm0 = Rm0 + sext(SIMM24); }
:MOVHU Rm2, (Rn0+, SIMM24) 	is entryfix=0 & op8=0xfd; op8=0xfa; Rm2 & Rn0; SIMM24 { *:2 Rn0 = Rm2:2; Rn0 = Rn0 + sext(SIMM24); }
:MOVHU (Rm0+, IMM32), Rn2 	is entryfix=0 & op8=0xfe; op8=0xea; Rn2 & Rm0; IMM32 { Rn2 = zext(*:2 Rm0); Rm0 = Rm0 + IMM32; }
:MOVHU Rm2, (Rn0+, IMM32) 	is entryfix=0 & op8=0xfe; op8=0xfa; Rm2 & Rn0; IMM32 { *:2 Rn0 = Rm2:2; Rn0 = Rn0 + IMM32; }
:MOVHU (IMM32, Rm0), Rn2 	is entryfix=0 & op8=0xfe; op8=0x4a; Rn2 & Rm0; IMM32 { Rn2 = zext(*:2 (Rm0 + IMM32)); }
:MOVHU Rm2, (IMM32, Rn0) 	is entryfix=0 & op8=0xfe; op8=0x5a; Rm2 & Rn0; IMM32 { *:2 (Rn0 + IMM32) = Rm2:2; }
:MOVHU (IMM32, "SP"), Rn2 	is entryfix=0 & op8=0xfe; op8=0xca; Rn2 & op4l=0; IMM32 { Rn2 = zext(*:2 (SP + IMM32)); }
:MOVHU Rm2, (IMM32, "SP") 	is entryfix=0 & op8=0xfe; op8=0xda; Rm2 & op4l=0; IMM32 { *:2 (SP + IMM32) = Rm2:2; }
:MOVHU Rm2, (IMM8) 	is entryfix=0 & op8=0xfb; op8=0x5e; Rm2 & op4l=0; IMM8 { local addr:4 = zext(IMM8); *:2 addr = Rm2:2; }
:MOVHU Rm2, (IMM24) 	is entryfix=0 & op8=0xfd; op8=0x5e; Rm2 & op4l=0; IMM24 { local addr:4 = zext(IMM24); *:2 addr = Rm2:2; }
